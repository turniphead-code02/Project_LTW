# ============================================================================
# CẤU HÌNH MÔI TRƯỜNG BACKEND — JOB PORTAL (NHÓM 6 UTH)
# Hướng dẫn: Sao chép tệp này thành .env (cp .env.example .env) trước khi chạy
# ============================================================================

# Cổng chạy Backend Server (phục vụ cả REST API và Static Frontend job-portal/)
PORT=5000
NODE_ENV=development

# Cấu hình kết nối MySQL 8.0+ / MariaDB (Khớp với database/schema.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=job_portal_db

# Khóa bí mật ký JWT Access Token & Refresh Token
JWT_ACCESS_SECRET=uth_nhom6_jobportal_access_secret_2026
JWT_REFRESH_SECRET=uth_nhom6_jobportal_refresh_secret_2026
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

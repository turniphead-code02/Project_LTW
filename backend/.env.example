# ============================================================================
# CẤU HÌNH MÔI TRƯỜNG BACKEND — JOB PORTAL (NHÓM 6 UTH)
# Hướng dẫn: Sao chép tệp này thành .env (cp .env.example .env) trước khi chạy
# ============================================================================

# Cổng chạy Backend Server (phục vụ cả REST API và Static Frontend job-portal/)
PORT=5000
NODE_ENV=development

# Cấu hình kết nối MySQL 8.0+ / TiDB Cloud MySQL (Khớp với database/schema.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=job_portal_db
# Bật true nếu dùng TiDB Cloud hoặc Cloud MySQL yêu cầu SSL/TLS
DB_SSL=false
# Tên miền Frontend được phép gọi API qua CORS (phân tách bởi dấu phẩy)
CORS_ORIGINS=https://portaljob-six.vercel.app

# Khóa bí mật ký JWT Access Token & Refresh Token
JWT_ACCESS_SECRET=uth_nhom6_jobportal_access_secret_2026
JWT_REFRESH_SECRET=uth_nhom6_jobportal_refresh_secret_2026
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Cấu hình SMTP gửi OTP quên mật khẩu (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=